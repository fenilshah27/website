{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "observability": { "enabled": true },
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
